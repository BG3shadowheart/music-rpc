{
  "manifest_version": 3,
  "name": "Music RPC - YouTube Music",
  "version": "2.0.0",
  "description": "Sends the currently playing YouTube Music track to the local Music RPC companion so it can appear in Discord Rich Presence.",
  "key": "",
  "homepage_url": "https://github.com/BG3shadowheart/music-rpc",
  "permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://music.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Music RPC - YouTube Music"
  }
}
